// ═══════════════════════════════════════════════════════════════════════════════
// §2  Graph Registration — 12 modules, 18 EDGE_REQUIRES
// ═══════════════════════════════════════════════════════════════════════════════

circuit polylabs_app_graph_register(graph: CsrStorage) -> CsrStorage
    lex polylabs/backend  @status production  @precision B  @attested true
    observe metrics: [polylabs_module_count, polylabs_edge_count]  meters [compute_cycles, memory_bytes]
{
    let (g, r)  = module_graph_add_module(graph, gateway_router_module())
    let (g, a)  = module_graph_add_module(g, gateway_auth_module())
    let (g, rl) = module_graph_add_module(g, gateway_rate_limit_module())
    let (g, bs) = module_graph_add_module(g, billing_subscription_module())
    let (g, bm) = module_graph_add_module(g, billing_metering_module())
    let (g, bb) = module_graph_add_module(g, billing_blinded_module())
    let (g, bt) = module_graph_add_module(g, billing_settlement_module())
    let (g, ar) = module_graph_add_module(g, admin_rbac_module())
    let (g, aa) = module_graph_add_module(g, admin_audit_module())
    let (g, ap) = module_graph_add_module(g, admin_provisioning_module())
    let (g, tg) = module_graph_add_module(g, tenant_graph_module())
    let (g, bd) = module_graph_add_module(g, billing_dag_module())

    let v = "0.1.0"
    let c = ">=0.1.0"

    let edge = |src, tgt, s_id, t_id| module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: src, source_version: v,
        target_module: tgt, target_version_constraint: c, metadata: bytes(0),
    }, s_id, t_id)

    let g = edge("gateway_router",       "gateway_auth",          r,  a)
    let g = edge("gateway_router",       "gateway_rate_limit",    r,  rl)
    let g = edge("gateway_router",       "tenant_graph",          r,  tg)
    let g = edge("gateway_auth",         "admin_rbac",            a,  ar)
    let g = edge("gateway_rate_limit",   "billing_metering",      rl, bm)
    let g = edge("billing_subscription", "tenant_graph",          bs, tg)
    let g = edge("billing_metering",     "billing_subscription",  bm, bs)
    let g = edge("billing_metering",     "tenant_graph",          bm, tg)
    let g = edge("billing_blinded",      "billing_subscription",  bb, bs)
    let g = edge("billing_settlement",   "billing_blinded",       bt, bb)
    let g = edge("billing_settlement",   "billing_dag",           bt, bd)
    let g = edge("billing_dag",          "billing_metering",      bd, bm)
    let g = edge("admin_audit",          "admin_rbac",            aa, ar)
    let g = edge("admin_audit",          "billing_settlement",    aa, bt)
    let g = edge("admin_provisioning",   "tenant_graph",          ap, tg)
    let g = edge("admin_provisioning",   "admin_rbac",            ap, ar)
    let g = edge("admin_provisioning",   "admin_audit",           ap, aa)
    let g = edge("tenant_graph",         "billing_subscription",  tg, bs)
    g
}

// ═══════════════════════════════════════════════════════════════════════════════
// §3  Cross-Graph Edges
// ═══════════════════════════════════════════════════════════════════════════════

data BridgeEdgeData : polylabs/backend/bridge v1 {
    source_lex: string, source_module: string,
    target_lex: string, target_module: string,
    bridge_type: string, timestamp_ms: u64,
}

circuit polylabs_register_bridge_edges(graph: CsrStorage) -> CsrStorage
    lex polylabs/backend  @status production  @precision B  @attested true
    observe metrics: [bridge_edge_count]  meters [compute_cycles]
{
    let mk = |src_mod, tgt_lex, tgt_mod, btype| serialize(BridgeEdgeData {
        source_lex: POLYLABS_APP_LEX, source_module: src_mod,
        target_lex: tgt_lex, target_module: tgt_mod,
        bridge_type: btype, timestamp_ms: 0,
    }) as bytes

    let b1 = mk("billing_metering", "polykit/metering",       "polykit_metering", "metering_aggregation")
    let b2 = mk("admin_rbac",       "polykit/rbac",            "polykit_rbac",     "role_composition")
    let b3 = mk("gateway_auth",     "core/identity/spark",     "spark_verify",     "auth_verification")
    let b4 = mk("billing_blinded",  "core/storage/scatter",    "scatter_cas",      "blinded_token_storage")

    let id_bm = find_polylabs_module_id(graph, "billing_metering")
    let id_ar = find_polylabs_module_id(graph, "admin_rbac")
    let id_ga = find_polylabs_module_id(graph, "gateway_auth")
    let id_bb = find_polylabs_module_id(graph, "billing_blinded")

    let (g, n1) = graph_add_node(graph, 0xB0, b1)
    let g = graph_add_edge(g, id_bm, n1, EDGE_BRIDGE_TO, b1)
    let (g, n2) = graph_add_node(g, 0xB0, b2)
    let g = graph_add_edge(g, id_ar, n2, EDGE_BRIDGE_TO, b2)
    let (g, n3) = graph_add_node(g, 0xB0, b3)
    let g = graph_add_edge(g, id_ga, n3, EDGE_BRIDGE_TO, b3)
    let (g, n4) = graph_add_node(g, 0xB0, b4)
    let g = graph_add_edge(g, id_bb, n4, EDGE_BRIDGE_TO, b4)
    g
}

circuit polylabs_register_governance_edges(graph: CsrStorage, governance_lex: string) -> CsrStorage
    lex polylabs/backend  @status production  @precision B  @attested true
    observe metrics: [governance_edge_count]  meters [compute_cycles]
{
    let modules = [
        "gateway_router", "gateway_auth", "gateway_rate_limit",
        "billing_subscription", "billing_metering", "billing_blinded",
        "billing_settlement", "admin_rbac", "admin_audit",
        "admin_provisioning", "tenant_graph", "billing_dag",
    ]
    let g = graph
    for name in modules {
        g = module_graph_add_governance_observe_edge(g, GovernanceObserveEdge {
            observer_lex: governance_lex, observer_module: "governance_core",
            observed_lex: POLYLABS_APP_LEX, observed_module: name,
            observe_scope: "full", read_only: true,
            witness_chain_required: false, refresh_interval_ms: 60000,
        }, find_polylabs_module_id(g, name))
    }
    g
}

// ── Internal helpers ────────────────────────────────────────────────────────────

circuit find_polylabs_module_id(graph: CsrStorage, name: string) -> u32
    lex polylabs/backend  @status production  @precision D
{
    for i in 0..graph.num_nodes {
        let module = deserialize(graph.node_data[i]) as ModuleNode
        if module.name == name { return i }
    }
    0xFFFFFFFF
}

// ── Metrics ─────────────────────────────────────────────────────────────────────

store series polylabs_app_graph_metrics lex polylabs/backend/metrics {
    operation: string key
    module_count: u32
    edge_count: u32
    bridge_edge_count: u32
    governance_edge_count: u32
}

// ── Properties & Tests ──────────────────────────────────────────────────────────

property safety "all_modules_registered" {
    forall name in ["gateway_router", "gateway_auth", "gateway_rate_limit",
        "billing_subscription", "billing_metering", "billing_blinded",
        "billing_settlement", "admin_rbac", "admin_audit",
        "admin_provisioning", "tenant_graph", "billing_dag"] :
        find_polylabs_module_id(graph, name) != 0xFFFFFFFF
}

property liveness "graph_registration_completes" {
    forall g in CsrStorage :
        polylabs_app_graph_register(g).num_nodes >= POLYLABS_MODULE_COUNT
}

test golden "register_all_12_modules" {
    setup { let graph = CsrStorage::new() }
    assert {
        let result = polylabs_app_graph_register(graph)
        result.num_nodes == 12
        find_polylabs_module_id(result, "gateway_router") != 0xFFFFFFFF
        find_polylabs_module_id(result, "billing_dag") != 0xFFFFFFFF
    }
}

test golden "bridge_edges_to_polykit" {
    setup { let graph = polylabs_app_graph_register(CsrStorage::new()) }
    assert {
        let result = polylabs_register_bridge_edges(graph)
        result.num_nodes > graph.num_nodes
        result.num_edges > graph.num_edges
    }
}

test golden "governance_edges_all_modules" {
    setup { let graph = polylabs_app_graph_register(CsrStorage::new()) }
    assert {
        let result = polylabs_register_governance_edges(graph, "core/governance")
        result.num_edges >= 12
    }
}
