{ make_polylabs_module("gateway_auth", AperturePartition::Head as u8, SLATier::Premium as u8,
    ResourceBudget8D { execution: 6000, hash_ops: 500, bandwidth: 2000, storage: 300, observe_events: 200, proofs: 20, consensus: 5, memory: 4096 }) }

