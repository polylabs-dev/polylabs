// Gateway Auth — SPARK authentication and per-product session establishment
//
// Lex Architecture:
//   esn/global/org/polyqlabs/gateway/auth
//   Each product derives its own SPARK identity via isolated HKDF context.
//   The gateway authenticates the SPARK challenge-response and establishes a
//   session scoped to exactly one product namespace. No cross-product session
//   correlation is possible — the backend never sees the root SPARK seed.
//
// Security:
//   All authentication paths are constant-time to prevent timing side channels.
//   Fuzz targets exercise the challenge-response and session establishment paths.

import qkit_identity

// ── Data ────────────────────────────────────────────────────────

data AuthSession : gateway v1 {
    session_id: bytes(32),
    product_id: bytes(16),
    spark_pubkey: bytes(2592),
    lex_namespace: string,
    established_at: u64,
    expires_at: u64,
    revoked: bool,
}
    store kv
    govern lex global/org/polyqlabs/gateway/auth/session
    cortex {
        redact [spark_pubkey]
        infer on_write
        on_anomaly alert "security-ops"
    }

data AuthChallenge : gateway v1 {
    challenge_id: bytes(32),
    product_id: bytes(16),
    nonce: bytes(32),
    issued_at: u64,
    expires_at: u64,
    consumed: bool,
}
    store kv
    govern lex global/org/polyqlabs/gateway/auth/challenge
    cortex {
        redact [nonce]
        infer on_write
        on_anomaly alert "security-ops"
    }

// ── Streams ─────────────────────────────────────────────────────

stream auth_events : event<AuthSession>
    | throttle 5000/s burst 10000

stream challenge_events : event<AuthChallenge>
    | throttle 5000/s burst 10000

// ── Circuits ────────────────────────────────────────────────────

circuit authenticate_spark(
    challenge_id: bytes(32),
    product_id: bytes(16),
    spark_pubkey: bytes(2592),
    signature: bytes(4627),
    lex_namespace: string
) -> AuthSession
    lex global/org/polyqlabs/gateway/auth
    @precision D
    constant_time true
    @observe metrics: [auth_attempts, auth_successes, auth_failures, auth_latency_us]
    monitor "auth_failure_rate" { auth_failures < 100 per 60s }
    invariant "challenge_exists" { eslite_exists("challenges", challenge_id) }
    invariant "challenge_not_expired" { eslite_query("challenges", challenge_id).expires_at > now() }
    invariant "challenge_not_consumed" { not eslite_query("challenges", challenge_id).consumed }
    meters [compute_cycles, memory_bytes]
    wasm_abi [eslite_query, eslite_insert, mldsa_verify, now, random_bytes]
    fuzz_target
{
    let challenge = eslite_query("challenges", challenge_id)
    let valid = mldsa_verify(challenge.nonce, signature, spark_pubkey)
    assert(valid, "spark_signature_invalid")

    let consumed = AuthChallenge { ..challenge, consumed: true }
    eslite_insert("challenges", challenge_id, consumed)

    let session_id = random_bytes(32)
    let session = AuthSession {
        session_id: session_id,
        product_id: product_id,
        spark_pubkey: spark_pubkey,
        lex_namespace: lex_namespace,
        established_at: now(),
        expires_at: now() + 86400,
        revoked: false,
    }
    eslite_insert("sessions", session_id, session)
    emit(auth_events, session)
    session
}

circuit establish_session(
    product_id: bytes(16),
    spark_pubkey: bytes(2592),
    lex_namespace: string
) -> AuthChallenge
    lex global/org/polyqlabs/gateway/auth
    @precision C
    constant_time true
    @observe metrics: [challenges_issued, challenge_latency_us]
    invariant "namespace_nonempty" { len(lex_namespace) > 0 }
    invariant "product_registered" { eslite_exists("route_configs", product_id) }
    meters [compute_cycles, memory_bytes]
    wasm_abi [eslite_insert, now, random_bytes]
    fuzz_target
{
    let nonce = random_bytes(32)
    let challenge_id = random_bytes(32)
    let challenge = AuthChallenge {
        challenge_id: challenge_id,
        product_id: product_id,
        nonce: nonce,
        issued_at: now(),
        expires_at: now() + 300,
        consumed: false,
    }
    eslite_insert("challenges", challenge_id, challenge)
    emit(challenge_events, challenge)
    challenge
}

circuit revoke_session(session_id: bytes(32)) -> bool
    lex global/org/polyqlabs/gateway/auth
    @precision C
    @observe metrics: [sessions_revoked]
    invariant "session_exists" { eslite_exists("sessions", session_id) }
    meters [compute_cycles]
    wasm_abi [eslite_query, eslite_insert]
{
    let session = eslite_query("sessions", session_id)
    let revoked = AuthSession { ..session, revoked: true }
    eslite_insert("sessions", session_id, revoked)
    true
}

// ── Properties ──────────────────────────────────────────────────

property safety "no_session_without_valid_challenge" {
    forall s in AuthSession :
        exists c in AuthChallenge :
            c.product_id == s.product_id and c.consumed == true
}

property safety "no_cross_product_sessions" {
    forall s1, s2 in AuthSession :
        s1.session_id != s2.session_id implies
            not (s1.spark_pubkey == s2.spark_pubkey and s1.product_id != s2.product_id)
            or s1.spark_pubkey != s2.spark_pubkey
}

property liveness "challenges_eventually_consumed_or_expire" {
    forall c in AuthChallenge :
        eventually(c.consumed == true or now() > c.expires_at)
}

// ── Tests ───────────────────────────────────────────────────────

test golden "establish_and_authenticate" {
    setup {
        eslite_insert("route_configs", hex("aa" * 16), RouteConfig {
            product_id: hex("aa" * 16),
            product_name: "qfiles",
            lex_namespace: "global/org/polyqlabs/files",
            wire_protocol_version: 1,
            max_payload_bytes: 67108864,
            enabled: true,
            priority: 1,
            created_at: 1000,
            updated_at: 1000,
        })
    }
    input {
        product_id: hex("aa" * 16)
        spark_pubkey: hex("dd" * 2592)
        lex_namespace: "global/org/polyqlabs/files"
    }
    assert {
        challenge.consumed == false
        challenge.product_id == hex("aa" * 16)
        len(challenge.nonce) == 32
        challenge.expires_at > challenge.issued_at
    }
}

test golden "revoke_session_basic" {
    setup {
        eslite_insert("sessions", hex("ee" * 32), AuthSession {
            session_id: hex("ee" * 32),
            product_id: hex("aa" * 16),
            spark_pubkey: hex("dd" * 2592),
            lex_namespace: "global/org/polyqlabs/files",
            established_at: 1000,
            expires_at: 87400,
            revoked: false,
        })
    }
    input {
        session_id: hex("ee" * 32)
    }
    assert {
        result == true
        eslite_query("sessions", hex("ee" * 32)).revoked == true
    }
}

// ── Fuzz ────────────────────────────────────────────────────────

fuzz_target "auth_challenge_response_fuzz" {
    inputs {
        challenge_id: bytes(32)
        product_id: bytes(16)
        spark_pubkey: bytes(2592)
        signature: bytes(4627)
        lex_namespace: string(1..256)
    }
    assert {
        no_panic
        constant_time true
    }
}
